+"""Small validated-metadata cache; every hit still verifies file contents.
+
+Only metadata is cached, never sensor histories or analysis results. The cache
+key includes reference, policy and date. All referenced bytes are SHA-256 checked
+on every request, so corruption is detected even if size/mtime are unchanged.
+"""
+from collections import OrderedDict
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import threading
+
+from .snapshots import MAX_FILE_BYTES, read_json
+
+
+def verify_files(root, ref):
+    path = root / ref['catalog']
+    if not path.resolve().is_relative_to(root.resolve()) or path.is_symlink():
+        raise ValueError('catalog_path_outside_root')
+    document, raw = read_json(path, 256 * 1024)
+    if hashlib.sha256(raw).hexdigest() != ref['sha256']:
+        raise ValueError('catalog_digest_mismatch')
+    seen = set()
+    for entry in document['sites'].values():
+        for name in entry['snapshots']:
+            source = path.parent / name
+            if (Path(name).name != name or source.is_symlink()
+                    or not source.resolve().is_relative_to(path.parent.resolve())
+                    or not source.is_file()):
+                raise ValueError('snapshot_path_outside_generation')
+            with source.open('rb') as stream:
+                raw = stream.read(MAX_FILE_BYTES + 1)
+            if len(raw) > MAX_FILE_BYTES or hashlib.sha256(raw).hexdigest() != ref['snapshots'].get(name):
+                raise ValueError('snapshot_digest_mismatch')
+            seen.add(name)
+    if seen != set(ref['snapshots']):
+        raise ValueError('snapshot_digest_set_mismatch')
+
+
+class CapabilitiesCache:
+    def __init__(self, limit=128):
+        self.limit = limit
+        self.entries = OrderedDict()
+        self.lock = threading.Lock()
+
+    def get(self, root, ref, day, policy, load):
+        key = (str(root.absolute()), day, json.dumps([ref, policy], sort_keys=True))
+        verify_files(root, ref)
+        with self.lock:
+            if key in self.entries:
+                self.entries.move_to_end(key)
+                return deepcopy(self.entries[key])
+        # Full validation and analysis happens only for a new immutable generation.
+        value = load().capabilities()
+        verify_files(root, ref)  # Do not cache a generation changed during validation.
+        with self.lock:
+            self.entries[key] = deepcopy(value)
+            self.entries.move_to_end(key)
+            while len(self.entries) > self.limit:
+                self.entries.popitem(last=False)
+        return value
