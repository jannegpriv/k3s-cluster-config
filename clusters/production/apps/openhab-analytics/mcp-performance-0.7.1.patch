+"""Integrity-preserving metadata reuse and nonblocking MCP request execution."""
+import asyncio
+from datetime import timedelta
+import hashlib
+import json
+import os
+from pathlib import Path
+import threading
+import time
+import unittest
+from unittest.mock import patch
+
+import test_feature_store as fixture
+from openhab_analytics.composite import CompositeCatalog
+from openhab_analytics.catalog import QueryError
+from openhab_analytics import feature_store, server
+from mcp.types import CallToolRequestParams
+
+
+class CacheTests(unittest.TestCase):
+    setUp = fixture.FeatureTests.setUp
+    save = fixture.FeatureTests.save
+    configure_ev = fixture.FeatureTests.configure_ev
+    setup_store = fixture.FeatureTests.setup_store
+    run_features = fixture.FeatureTests.run_features
+
+    def prepare(self):
+        self.setup_store(); self.run_features()
+        self.catalog = CompositeCatalog(self.daily, self.feature)
+        return self.catalog.request_view().capabilities()
+
+    def test_warm_capabilities_match_cold_without_reanalysis(self):
+        first = self.prepare()
+        with patch('openhab_analytics.snapshots.analyze', side_effect=AssertionError('reanalysis')):
+            self.assertEqual(first, self.catalog.request_view().capabilities())
+            self.assertEqual(first['sites'], self.catalog.request_view().capabilities('house')['sites'])
+        first['sites'].clear()
+        self.assertTrue(self.catalog.request_view().capabilities()['sites'])
+
+    def test_same_size_restored_mtime_corruption_and_recovery(self):
+        self.prepare(); ref=feature_store.read_index(self.feature)['days']['2026-10-18']
+        p=(self.feature/ref['catalog']).parent/next(iter(ref['snapshots']))
+        raw=p.read_bytes(); st=p.stat()
+        changed=raw.replace(b'"schema_version":1',b'"schema_version":2')
+        self.assertNotEqual(changed,raw)
+        p.write_bytes(changed);os.utime(p,ns=(st.st_atime_ns,st.st_mtime_ns))
+        self.assertEqual(self.catalog.request_view().capabilities()['feature_status'],'unavailable')
+        p.write_bytes(raw)
+        self.assertEqual(self.catalog.request_view().capabilities()['feature_status'],'available')
+
+    def test_new_generation_revalidates_and_old_view_is_pinned(self):
+        self.prepare(); old=self.catalog.request_view();before=old.capabilities()
+        self.run_features(fixture.NOW+timedelta(minutes=15))
+        self.assertEqual(old.capabilities(),before)
+        after=self.catalog.request_view().capabilities()
+        self.assertNotEqual(before['sites'][0]['partial_windows'],after['sites'][0]['partial_windows'])
+        self.assertEqual(self.catalog.request_view().energy('house','2026-10-18')['reported_load_energy_kwh'],12.25)
+
+    def test_changed_policy_and_unknown_site_fail_closed(self):
+        self.prepare()
+        with patch('openhab_analytics.snapshots.analyze',side_effect=AssertionError('must reject before reading')):
+            with self.assertRaisesRegex(QueryError,'unknown_site'):
+                self.catalog.request_view().capabilities('House')
+        p=self.feature/'active.json';ix=json.loads(p.read_text());ix['policy']['house']['heating']['additional_heat_semantics']='invalid';p.write_text(json.dumps(ix))
+        self.assertEqual(self.catalog.request_view().capabilities()['feature_status'],'unavailable')
+
+    def test_deletion_and_symlink_cannot_reuse_cache(self):
+        self.prepare();ref=feature_store.read_index(self.feature)['days']['2026-10-18']
+        p=(self.feature/ref['catalog']).parent/next(iter(ref['snapshots']));raw=p.read_bytes();p.unlink()
+        self.assertEqual(self.catalog.request_view().capabilities()['feature_status'],'unavailable')
+        target=self.folder/'outside.json';target.write_bytes(raw);p.symlink_to(target)
+        self.assertEqual(self.catalog.request_view().capabilities()['feature_status'],'unavailable')
+
+
+class AsyncTests(unittest.IsolatedAsyncioTestCase):
+    async def test_slow_call_does_not_block_other_requests(self):
+        callbacks={}
+        def capture(*a,**kw): callbacks.update(kw);return object()
+        started=threading.Event();release=threading.Event()
+        class Catalog:
+            def capabilities(self,**kw):started.set();release.wait(5);return {'sites':[]}
+            def energy(self,**kw):raise QueryError('unknown_site')
+            ev = history = statistics = energy
+        with patch.object(server,'Server',side_effect=capture):server.make_server(Catalog())
+        callback=callbacks['on_call_tool']
+        slow=asyncio.create_task(callback(None,CallToolRequestParams(name='get_history_capabilities',arguments={})))
+        try:
+            self.assertTrue(await asyncio.to_thread(started.wait,2))
+            quick=await asyncio.wait_for(callback(None,CallToolRequestParams(name='get_energy_summary',arguments={'site':'missing','date':'2026-11-20'})),1)
+            self.assertTrue(quick.is_error);self.assertFalse(slow.done())
+        finally:release.set();await slow
+
+    async def test_cancellation_does_not_free_a_running_worker_slot(self):
+        callbacks={};lock=threading.Lock();active=0;peak=0;release=threading.Event();both=threading.Event()
+        def capture(*a,**kw):callbacks.update(kw);return object()
+        class Catalog:
+            def capabilities(self,**kw):
+                nonlocal active,peak
+                with lock:
+                    active+=1;peak=max(peak,active)
+                    if active==2:both.set()
+                release.wait(5)
+                with lock:active-=1
+                return {'sites':[]}
+            def energy(self,**kw):raise QueryError('unknown_site')
+            ev = history = statistics = energy
+        with patch.object(server,'Server',side_effect=capture):server.make_server(Catalog())
+        cb=callbacks['on_call_tool'];params=CallToolRequestParams(name='get_history_capabilities',arguments={})
+        tasks=[asyncio.create_task(cb(None,params)) for _ in range(2)]
+        self.assertTrue(await asyncio.to_thread(both.wait,2));tasks[0].cancel()
+        await asyncio.gather(tasks[0],return_exceptions=True)
+        third=asyncio.create_task(cb(None,params))
+        await asyncio.sleep(.1);self.assertEqual(peak,2);self.assertFalse(third.done())
+        release.set();await asyncio.gather(tasks[1],third)
+        self.assertEqual(peak,2)
