    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "analytics-collect-features",
        "namespace": "openhab-analytics",
        "labels": {
          "app.kubernetes.io/name": "openhab-analytics"
        }
      },
      "spec": {
        "schedule": "7,22,37,52 * * * *",
        "timeZone": "Europe/Stockholm",
        "suspend": false,
        "concurrencyPolicy": "Forbid",
        "startingDeadlineSeconds": 600,
        "successfulJobsHistoryLimit": 2,
        "failedJobsHistoryLimit": 3,
        "jobTemplate": {
          "spec": {
            "backoffLimit": 2,
            "activeDeadlineSeconds": 1200,
            "ttlSecondsAfterFinished": 172800,
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "openhab-analytics",
                  "analytics-role": "collector",
                  "analytics-feature": "intraday"
                },
                "annotations": {
                  "analytics.openhab/credential-revision": "20261022-registry-v1"
                }
              },
              "spec": {
                "automountServiceAccountToken": false,
                "serviceAccountName": "analytics",
                "enableServiceLinks": false,
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "fsGroup": 10001,
                  "fsGroupChangePolicy": "OnRootMismatch",
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "nodeSelector": {
                  "kubernetes.io/hostname": "k3s-w-1",
                  "kubernetes.io/arch": "arm64"
                },
                "terminationGracePeriodSeconds": 30,
                "volumes": [
                  {
                    "name": "data",
                    "persistentVolumeClaim": {
                      "claimName": "analytics-features",
                      "readOnly": false
                    }
                  },
                  {
                    "name": "tmp",
                    "emptyDir": {
                      "sizeLimit": "128Mi"
                    }
                  },
                  {
                    "name": "runtime-secrets",
                    "emptyDir": {
                      "medium": "Memory",
                      "sizeLimit": "1Mi"
                    }
                  },
                  {
                    "name": "projected-secrets",
                    "secret": {
                      "secretName": "analytics-openhab",
                      "defaultMode": 288,
                      "items": [
                        {
                          "key": "huddinge",
                          "path": "huddinge"
                        },
                        {
                          "key": "landet",
                          "path": "landet"
                        }
                      ]
                    }
                  },
                  {
                    "name": "config",
                    "configMap": {
                      "name": "analytics-feature-sources"
                    }
                  }
                ],
                "initContainers": [
                  {
                    "name": "stage-secrets",
                    "image": "ghcr.io/jannegpriv/openhab-analytics-collector@sha256:042b7446a1433c40f96f9104fc438dbd5a026c5b890d92d4d67ce81a497ec80d",
                    "args": [
                      "stage-secrets",
                      "--names",
                      "huddinge",
                      "landet"
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    },
                    "resources": {
                      "requests": {
                        "cpu": "10m",
                        "memory": "32Mi"
                      },
                      "limits": {
                        "cpu": "200m",
                        "memory": "128Mi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "projected-secrets",
                        "mountPath": "/projected-secrets",
                        "readOnly": true
                      },
                      {
                        "name": "runtime-secrets",
                        "mountPath": "/runtime",
                        "readOnly": false
                      }
                    ]
                  }
                ],
                "containers": [
                  {
                    "name": "collector",
                    "image": "ghcr.io/jannegpriv/openhab-analytics-collector@sha256:042b7446a1433c40f96f9104fc438dbd5a026c5b890d92d4d67ce81a497ec80d",
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    },
                    "resources": {
                      "requests": {
                        "cpu": "100m",
                        "memory": "128Mi"
                      },
                      "limits": {
                        "cpu": "1000m",
                        "memory": "512Mi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "data",
                        "mountPath": "/features",
                        "readOnly": false
                      },
                      {
                        "name": "tmp",
                        "mountPath": "/tmp",
                        "readOnly": false
                      },
                      {
                        "name": "runtime-secrets",
                        "mountPath": "/runtime",
                        "readOnly": true
                      },
                      {
                        "name": "config",
                        "mountPath": "/config",
                        "readOnly": true
                      }
                    ],
                    "args": [
                      "collect-features",
                      "--root",
                      "/features/catalog"
                    ]
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "analytics-registry"
                  }
                ],
                "restartPolicy": "Never"
              }
            }
          }
        }
      }
    },
