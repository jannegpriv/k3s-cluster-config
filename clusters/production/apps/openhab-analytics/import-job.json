{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "analytics-import-20261022",
    "namespace": "openhab-analytics"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 1800,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "openhab-analytics",
          "analytics-role": "import"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "nodeSelector": {
          "kubernetes.io/hostname": "k3s-w-1",
          "kubernetes.io/arch": "arm64"
        },
        "imagePullSecrets": [
          {
            "name": "analytics-registry"
          }
        ],
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "runAsGroup": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          },
          "fsGroup": 10001,
          "fsGroupChangePolicy": "OnRootMismatch"
        },
        "containers": [
          {
            "name": "import",
            "image": "ghcr.io/jannegpriv/openhab-analytics-backup@sha256:15041e38fc64c4815fc4bde6cbf8292a8f4eabdef1873b3bf49ecf2542df8bde",
            "imagePullPolicy": "Always",
            "command": [
              "python",
              "-c",
              "import os,time,json,hashlib\nfrom pathlib import Path\nfrom backup_store import restore,digest\nfrom openhab_analytics.daily import DailyCatalog\nos.umask(0o077)\narchive=Path('/work/migration.tar.gz')\nwhile not archive.exists():time.sleep(1)\nassert digest(archive)=='e8ed776fa60b5a20f082791daf3ea92ed78080f317b7472da981412e0acff8b7', 'transfer_checksum'\nresult=restore(archive,Path('/store/daily'))\nview=DailyCatalog(Path('/store/daily')).request_view()\nanswers={day:{'energy':{site:view.energy(site,day) for site in ('huddinge','landet')},'ev':view.ev('huddinge',day)} for day in sorted(view.index['days'])}\nfingerprint=hashlib.sha256(json.dumps(answers,sort_keys=True,separators=(',',':')).encode()).hexdigest()\nassert fingerprint=='6d1464ce6b0e5bc48516a579a3f2af96a7ff9658320403af26c77e9e7514b036', 'answer_mismatch'\nresult.update(answers_sha256=fingerprint,archive_sha256=digest(archive),energy_and_ev_equal=True)\nprint(json.dumps(result))\n"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "1000m",
                "memory": "512Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/store"
              },
              {
                "name": "work",
                "mountPath": "/work"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "analytics-data"
            }
          },
          {
            "name": "work",
            "emptyDir": {
              "sizeLimit": "128Mi"
            }
          }
        ]
      }
    }
  }
}
