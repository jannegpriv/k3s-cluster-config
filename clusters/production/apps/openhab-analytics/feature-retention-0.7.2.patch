+    def test_full_catalog_midnight_catchup_never_reimports_evicted_days(self):
+        self.setup_store()
+        # Fill a real catalog, including the 25-hour autumn DST day.
+        for n in range(32):
+            self.run_features(datetime(2026,10,24,11,tzinfo=timezone.utc)+timedelta(days=n))
+        old=store.read_index(self.feature)
+        self.assertEqual(len(old['days']),31)
+        self.assertIn('2026-10-25',old['days'])
+        self.assertTrue(old['days']['2026-11-24']['partial'])
+        self.assertEqual(store.checked(self.feature,old,'2026-10-25').energy('house','2026-10-25')['reported_load_energy_kwh'],25)
+        # The first new-day publication evicts Oct 25; following retries must
+        # not reimport it merely because target_day still points to Nov 23.
+        for clock in ['00:07','00:22','01:37','04:07','04:14','04:15','04:22']:
+            now=datetime.fromisoformat('2026-11-25T'+clock+':00+01:00')
+            self.fake.requests.clear()
+            result=store.run(self.feature,self.config_path,now=now)
+            self.assertIn(result['status'],('success','up_to_date'),result)
+            for request in self.fake.requests:
+                self.assertNotIn('2026-10-25',str(request))
+            ix=store.read_index(self.feature)
+            self.assertEqual(len(ix['days']),31)
+            self.assertNotIn('2026-10-25',ix['days'])
+            self.assertEqual(ix['days']['2026-11-24']['partial'],clock<'04:15')
+        self.assertEqual(self.daily_bytes,(self.daily/'active.json').read_bytes())
+
