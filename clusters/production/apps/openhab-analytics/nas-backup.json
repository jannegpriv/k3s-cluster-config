        }
      },
      "data": {
        "nas.json": "{\"host\": \"192.168.50.25\", \"port\": 4711, \"user\": \"jannenasadm\", \"directory\": \"/volume1/k3s_backups/openhab-analytics\", \"authentication\": \"password\"}",
        "known_hosts": "[192.168.50.25]:4711 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICksWARfXymmfEEZaERS6y10g1v/8/ujWVlxW38SpLQQ\n"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "backup-nas",
        "namespace": "openhab-analytics",
        "labels": {
          "app.kubernetes.io/name": "openhab-analytics"
