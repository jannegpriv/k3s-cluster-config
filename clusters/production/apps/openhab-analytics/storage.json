{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "analytics-data",
        "namespace": "openhab-analytics",
        "labels": {
          "app.kubernetes.io/name": "openhab-analytics"
        },
        "annotations": {
          "kustomize.toolkit.fluxcd.io/prune": "disabled"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "rook-ceph-block",
        "resources": {
          "requests": {
            "storage": "2Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "analytics-operations",
        "namespace": "openhab-analytics",
        "labels": {
          "app.kubernetes.io/name": "openhab-analytics"
        },
        "annotations": {
          "kustomize.toolkit.fluxcd.io/prune": "disabled"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "rook-ceph-block",
        "resources": {
          "requests": {
            "storage": "100Mi"
          }
        }
      }
    }
  ]
}
