{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "PrometheusRule",
      "metadata": {
        "name": "analytics-alerts",
        "namespace": "openhab-analytics",
        "labels": {
          "app.kubernetes.io/name": "openhab-analytics",
          "release": "kube-prometheus-stack"
        }
      },
      "spec": {
        "groups": [
          {
            "name": "openhab-analytics",
            "rules": [
              {
                "alert": "AnalyticsMonitorMissing",
                "expr": "absent(up{namespace=\"openhab-analytics\",service=\"analytics-monitor\"}) or up{namespace=\"openhab-analytics\",service=\"analytics-monitor\"} == 0",
                "for": "10m",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics övervakning saknas",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsCatalogInvalid",
                "expr": "openhab_analytics_catalog_valid{namespace=\"openhab-analytics\"} == 0",
                "for": "5m",
                "labels": {
                  "severity": "critical",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics datakatalog kan inte verifieras",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsCollectionMissing",
                "expr": "openhab_analytics_pending_days{namespace=\"openhab-analytics\"} > 0",
                "for": "90m",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics saknar ett eller flera förväntade dygn",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsCollectionFailed",
                "expr": "openhab_analytics_collection_failed{namespace=\"openhab-analytics\"} == 1",
                "for": "15m",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics senaste insamling misslyckades",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsBackupMissing",
                "expr": "openhab_analytics_backup_valid{namespace=\"openhab-analytics\"} == 0 or time() - openhab_analytics_backup_verified_timestamp_seconds{namespace=\"openhab-analytics\"} > 93600",
                "for": "30m",
                "labels": {
                  "severity": "critical",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics saknar färsk verifierad NAS-backup",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsBackupFailed",
                "expr": "openhab_analytics_backup_last_attempt_failed{namespace=\"openhab-analytics\"} == 1",
                "for": "15m",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics senaste NAS-backup misslyckades",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsBackupBehind",
                "expr": "openhab_analytics_backup_matches_generation{namespace=\"openhab-analytics\"} == 0",
                "for": "2h",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics senaste publicering saknar verifierad backup",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsDiskLow",
                "expr": "openhab_analytics_storage_available_bytes{namespace=\"openhab-analytics\"} / openhab_analytics_storage_capacity_bytes{namespace=\"openhab-analytics\"} < 0.2",
                "for": "15m",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics har mindre än 20 procent ledigt diskutrymme",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsDiskCritical",
                "expr": "openhab_analytics_storage_available_bytes{namespace=\"openhab-analytics\"} / openhab_analytics_storage_capacity_bytes{namespace=\"openhab-analytics\"} < 0.1",
                "for": "5m",
                "labels": {
                  "severity": "critical",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics har mindre än 10 procent ledigt diskutrymme",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsMetadataInvalid",
                "expr": "openhab_analytics_credential_metadata_valid{namespace=\"openhab-analytics\"} == 0 or openhab_analytics_storage_valid{namespace=\"openhab-analytics\"} == 0",
                "for": "10m",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics driftmetadata kan inte läsas",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsCredentialExpiring",
                "expr": "openhab_analytics_credential_expiry_timestamp_seconds{namespace=\"openhab-analytics\"} - time() < 1209600",
                "for": "1h",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "En Analytics-nyckel löper ut inom 14 dagar",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsCredentialReviewDue",
                "expr": "openhab_analytics_credential_review_timestamp_seconds{namespace=\"openhab-analytics\"} < time()",
                "for": "1h",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "En Analytics-nyckel behöver ses över",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsWorkloadUnavailable",
                "expr": "kube_deployment_spec_replicas{namespace=\"openhab-analytics\"} > 0 and on(namespace,deployment) kube_deployment_status_replicas_available{namespace=\"openhab-analytics\"} == 0",
                "for": "10m",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "En Analytics-tjänst är inte tillgänglig",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              },
              {
                "alert": "AnalyticsMaintenanceFailed",
                "expr": "openhab_analytics_maintenance_valid{namespace=\"openhab-analytics\"} == 0 or openhab_analytics_maintenance_failed{namespace=\"openhab-analytics\"} == 1 or time() - openhab_analytics_maintenance_timestamp_seconds{namespace=\"openhab-analytics\"} > 93600",
                "for": "30m",
                "labels": {
                  "severity": "warning",
                  "application": "openhab-analytics"
                },
                "annotations": {
                  "summary": "Analytics historikgallring eller NAS-arkivkontroll behöver tillsyn",
                  "description": "Kontrollera Analytics driftstatus och körjournal innan omstart eller återställning."
                }
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "analytics-maintenance",
        "namespace": "openhab-analytics",
        "labels": {
          "app.kubernetes.io/name": "openhab-analytics"
        }
      },
      "spec": {
        "schedule": "45 2 * * *",
        "timeZone": "Europe/Stockholm",
        "suspend": false,
        "concurrencyPolicy": "Forbid",
        "startingDeadlineSeconds": 3600,
        "successfulJobsHistoryLimit": 2,
        "failedJobsHistoryLimit": 3,
        "jobTemplate": {
          "spec": {
            "backoffLimit": 0,
            "activeDeadlineSeconds": 1800,
            "ttlSecondsAfterFinished": 172800,
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "openhab-analytics",
                  "analytics-role": "maintenance"
                },
                "annotations": {
                  "analytics.openhab/credential-revision": "nas-bm-password-20261022"
                }
              },
              "spec": {
                "automountServiceAccountToken": false,
                "serviceAccountName": "analytics",
                "enableServiceLinks": false,
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "fsGroup": 10001,
                  "fsGroupChangePolicy": "OnRootMismatch",
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "nodeSelector": {
                  "kubernetes.io/hostname": "k3s-w-1",
                  "kubernetes.io/arch": "arm64"
                },
                "imagePullSecrets": [
                  {
                    "name": "analytics-registry"
                  }
                ],
                "initContainers": [
                  {
                    "name": "stage-secrets",
                    "image": "ghcr.io/jannegpriv/openhab-analytics-collector@sha256:232f2a73c88c26d8e9622d3b5e42e549f482a1e8b6a4f165167d516be93895e6",
                    "args": [
                      "stage-secrets",
                      "--names",
                      "password"
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    },
                    "resources": {
                      "requests": {
                        "cpu": "10m",
                        "memory": "32Mi"
                      },
                      "limits": {
                        "cpu": "200m",
                        "memory": "128Mi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "credentials",
                        "mountPath": "/projected-secrets",
                        "readOnly": true
                      },
                      {
                        "name": "runtime",
                        "mountPath": "/runtime",
                        "readOnly": false
                      }
                    ]
                  }
                ],
                "containers": [
                  {
                    "name": "maintenance",
                    "image": "ghcr.io/jannegpriv/openhab-analytics-backup@sha256:3585a6450201fc84b5d1b522ffd77c28afa43ff40ce892a9633fdf34f3941998",
                    "args": [
                      "--apply"
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    },
                    "resources": {
                      "requests": {
                        "cpu": "100m",
                        "memory": "128Mi",
                        "ephemeral-storage": "512Mi"
                      },
                      "limits": {
                        "cpu": "1000m",
                        "memory": "512Mi",
                        "ephemeral-storage": "4Gi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "data",
                        "mountPath": "/store",
                        "readOnly": false
                      },
                      {
                        "name": "runtime",
                        "mountPath": "/runtime",
                        "readOnly": true
                      },
                      {
                        "name": "work",
                        "mountPath": "/work",
                        "readOnly": false
                      },
                      {
                        "name": "tmp",
                        "mountPath": "/tmp",
                        "readOnly": false
                      },
                      {
                        "name": "config",
                        "mountPath": "/config",
                        "readOnly": true
                      },
                      {
                        "name": "operations",
                        "mountPath": "/operations"
                      }
                    ],
                    "command": [
                      "python",
                      "/app/maintenance.py"
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "credentials",
                    "secret": {
                      "secretName": "analytics-nas",
                      "defaultMode": 288,
                      "items": [
                        {
                          "key": "password",
                          "path": "password"
                        }
                      ]
                    }
                  },
                  {
                    "name": "runtime",
                    "emptyDir": {
                      "medium": "Memory",
                      "sizeLimit": "1Mi"
                    }
                  },
                  {
                    "name": "tmp",
                    "emptyDir": {
                      "sizeLimit": "128Mi"
                    }
                  },
                  {
                    "name": "data",
                    "persistentVolumeClaim": {
                      "claimName": "analytics-data",
                      "readOnly": false
                    }
                  },
                  {
                    "name": "work",
                    "emptyDir": {
                      "sizeLimit": "4Gi"
                    }
                  },
                  {
                    "name": "config",
                    "configMap": {
                      "name": "analytics-nas"
                    }
                  },
                  {
                    "name": "operations",
                    "persistentVolumeClaim": {
                      "claimName": "analytics-operations"
                    }
                  }
                ],
                "restartPolicy": "Never"
              }
            }
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "maintenance-nas",
        "namespace": "openhab-analytics",
        "labels": {
          "app.kubernetes.io/name": "openhab-analytics"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "analytics-role": "maintenance"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "192.168.50.25/32"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 4711
              }
            ]
          }
        ]
      }
    }
  ]
}
