// openHAB IP Camera things for the Landet cameras via camera-bridge (go2rtc).
// TEMPLATE - rendered by scripts/camera-bridge-things.sh (fills @@RTSP_*@@ from
// the SOPS secret) and copied to /openhab/conf/things/cameras.things.
// The binding inserts username/password into the RTSP URL itself
// ("Leave any user:pass@ out of any URLs, the binding will handle this").
// HLS segments go to /dev/shm (RAM, 64 MiB tmpfs in the container): 4 x 2 s
// segments per camera, deleted as they age. Nothing is polled or pre-rolled:
// go2rtc only opens the Tapo session while openHAB's HLS is being watched
// (+ the binding's ~64 s idle timeout).

Thing ipcamera:generic:c720_lillstugan "Lillstugan – C720" [
    // For generic things ipAddress/port are ONLY used for HTTP (snapshotUrl);
    // the binding ignores the host in snapshotUrl and connects to ipAddress:port.
    // Point them at openHAB itself (static placeholder) - RTSP is explicit below.
    ipAddress="127.0.0.1",
    port=8080,
    username="@@RTSP_USER@@",
    password="@@RTSP_PASS@@",
    // Static placeholder served by openHAB itself. WITHOUT this the binding
    // auto-selects "ffmpeg snapshot" mode and runs a permanent ffmpeg per
    // camera against the bridge -> permanent Tapo session -> drained battery.
    snapshotUrl="http://127.0.0.1:8080/static/camera-idle.jpg",
    ffmpegLocation="/usr/bin/ffmpeg",
    ffmpegInput="rtsp://camera-bridge.openhab.svc.cluster.local:8554/c720_lillstugan",
    ffmpegInputOptions="-rtsp_transport tcp",
    ffmpegOutput="/dev/shm/ipcamera/c720_lillstugan/",
    hlsOutOptions="-strict -2 -f lavfi -i aevalsrc=0 -map 0:v:0 -map 1:a:0 -acodec aac -vcodec copy -hls_flags delete_segments+append_list+discont_start -hls_time 4 -hls_list_size 6",
    updateImageWhen="0",
    gifPreroll=0,
    ipWhitelist="DISABLE"
]

