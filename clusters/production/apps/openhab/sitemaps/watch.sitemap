sitemap watch label="watch"
{
        Frame label="Topfloor" {
                Switch item=gAllTopfloorLights label="Top floor lights"
        }
        Frame label="Frontdoor" {
                Switch item=YaledoormanSmartlock_SmartLockStatus label="Smart Lock"
        }
        Frame label="Lynk & Co 08" {
                Switch item=LynkCo_Vehicle_Door_Lock_Control label="Bil-lås"
                Switch item=LynkCo_Vehicle_Preclimatization_Control label="Förvärmning"
                Setpoint item=LynkCo_Vehicle_Target_Temp_Control label="Måltemp [%.0f °C]" minValue=16 maxValue=28 step=1
                Switch item=LynkCo_Vehicle_Ventilation_Control label="Vädra"
                Switch item=LynkCo_Vehicle_Sunroof_Control label="Taklucka"
        }
        Frame label="Landet" {
                Switch item=Remote_openHAB_Server_Landet_Item_Water_Control_Open_Valve_with_Duration label="Vattna"
                Switch item=Remote_openHAB_Server_Landet_Item_Water_Control_Close_All_Valves label="Stäng vattnet"
                Switch item=Remote_openHAB_Server_Landet_Item_Sensibo_Sky_Jans_device_Master_Switch label="Värmepump"
                Setpoint item=Remote_openHAB_Server_Landet_Item_Sensibo_Sky_Jans_device_Target_Temperature label="Pump måltemp [%.0f °C]" minValue=10 maxValue=25 step=1
                Text item=Remote_openHAB_Server_Landet_Item_Gateway_Device_Temperature_Channel_3 label="Stora Gla [%.1f °C]"
        }
}